# ============================================
# Qadirdon AI - Environment Variables
# ============================================

# --- Telegram Bot ---
# Bitta bot orqali ham menyu, ham Telegram Business shaxsiy profil boshqaruvi ishlaydi!
BOT_TOKEN=your_telegram_bot_token_here

# --- Admin va To'lov ---
# Adminning Telegram ID si (bir nechta bo'lsa vergul bilan: 12345678,87654321)
ADMIN_IDS=12345678
ADMIN_USERNAME=@admin_username
CARD_NUMBER=8600000000000000
CARD_HOLDER=Qadirdon AI

# --- Pyrogram (VoIP / Ovozli qo'ng'iroq) ---
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+998XXXXXXXXX

# --- AI (Gemini) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Google Cloud (TTS/STT) ---
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./qadirdon_ai.db
# PostgreSQL uchun:
# DATABASE_URL=postgresql+asyncpg://qadirdon:password@localhost:5432/qadirdon_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Server ---
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443
WEBHOOK_SECRET=your_random_secret_string

# --- App ---
DEBUG=true
LOG_LEVEL=INFO
